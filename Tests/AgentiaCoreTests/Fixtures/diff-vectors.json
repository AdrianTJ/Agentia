{
  "_comment": "Generated by tools/verify-diff-vectors.py. Expected values are produced by running the reference implementation, not written by hand. AgentiaCoreTests asserts the same vectors.",
  "quadraticLimit": 2000,
  "cases": [
    {
      "name": "identical documents produce no ranges",
      "old": "# Title\n\nBody.\n",
      "new": "# Title\n\nBody.\n",
      "expected": []
    },
    {
      "name": "appended section is added, not modified",
      "old": "# Title\n\nBody.\n",
      "new": "# Title\n\nBody.\n\n## New\n\nMore.\n",
      "expected": [
        {
          "start": 4,
          "end": 7,
          "kind": "added"
        }
      ]
    },
    {
      "name": "replaced line is modified",
      "old": "# Title\n\nOld body.\n",
      "new": "# Title\n\nNew body.\n",
      "expected": [
        {
          "start": 3,
          "end": 3,
          "kind": "modified"
        }
      ]
    },
    {
      "name": "insertion in the middle is added",
      "old": "line one\nline three\n",
      "new": "line one\nline two\nline three\n",
      "expected": [
        {
          "start": 2,
          "end": 2,
          "kind": "added"
        }
      ]
    },
    {
      "name": "deletion alone produces no range",
      "old": "keep\ndrop\nkeep two\n",
      "new": "keep\nkeep two\n",
      "expected": []
    },
    {
      "name": "replacement of several lines by fewer",
      "old": "a\nb\nc\nd\ne\n",
      "new": "a\nX\ne\n",
      "expected": [
        {
          "start": 2,
          "end": 2,
          "kind": "modified"
        }
      ]
    },
    {
      "name": "replacement of few lines by several",
      "old": "a\nX\ne\n",
      "new": "a\nb\nc\nd\ne\n",
      "expected": [
        {
          "start": 2,
          "end": 4,
          "kind": "modified"
        }
      ]
    },
    {
      "name": "two separate changes yield two ranges",
      "old": "a\nb\nc\nd\ne\nf\ng\n",
      "new": "a\nB\nc\nd\ne\nF\ng\n",
      "expected": [
        {
          "start": 2,
          "end": 2,
          "kind": "modified"
        },
        {
          "start": 6,
          "end": 6,
          "kind": "modified"
        }
      ]
    },
    {
      "name": "prepended content is added at line 1",
      "old": "existing\n",
      "new": "brand new\nexisting\n",
      "expected": [
        {
          "start": 1,
          "end": 1,
          "kind": "added"
        }
      ]
    },
    {
      "name": "empty old document yields nothing (first open)",
      "old": "",
      "new": "# Anything\n\nBody.\n",
      "expected": []
    },
    {
      "name": "empty new document yields nothing",
      "old": "# Anything\n",
      "new": "",
      "expected": []
    },
    {
      "name": "CRLF rewrite alone is not a change",
      "old": "a\nb\nc\n",
      "new": "a\r\nb\r\nc\r\n",
      "expected": []
    },
    {
      "name": "trailing newline added is not a change",
      "old": "a\nb",
      "new": "a\nb\n",
      "expected": []
    },
    {
      "name": "whole document replaced",
      "old": "old one\nold two\n",
      "new": "new one\nnew two\n",
      "expected": [
        {
          "start": 1,
          "end": 2,
          "kind": "modified"
        }
      ]
    },
    {
      "name": "realistic agent rewrite: table row updated and section appended",
      "old": "# Report\n\n| m | v |\n| - | - |\n| a | 1 |\n\nDone.\n",
      "new": "# Report\n\n| m | v |\n| - | - |\n| a | 2 |\n\nDone.\n\n## Notes\n\nAdded.\n",
      "expected": [
        {
          "start": 5,
          "end": 5,
          "kind": "modified"
        },
        {
          "start": 8,
          "end": 11,
          "kind": "added"
        }
      ]
    }
  ]
}
